"cds/export" -> "cds/storage/walkerstores" [label="1", penwidth=1.1];
"cds/export" -> "walker/datanode/client" [label="1", penwidth=1.1];
"cds/export" -> "walker/wkeys" [label="1", penwidth=1.1];
"cds/storage" -> "walker/wkeys" [label="1", penwidth=1.1];
"cds/storage/walkerstores" -> "cds/storage" [label="1", penwidth=1.1];
"cds/storage/walkerstores" -> "walker/datanode/client" [label="1", penwidth=1.1];
"cds/storage/walkerstores" -> "walker/wkeys" [label="1", penwidth=1.1];
"walker/datanode/client" -> "walker/wkeys" [label="1", penwidth=1.1];
}